# Supabase — get from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq — get from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# ── Recipe image seeding ──────────────────────────────────────────────────────
# After deployment, call this endpoint once to populate recipe images:
#   GET https://your-app.vercel.app/api/admin/seed-images?secret=SUPABASE_SERVICE_ROLE_KEY
#
# The route scrapes og:image from each recipe's source page first.
# For pages that block scraping it falls back to Pollinations.ai AI-generated
# images (free, no API key required).
#
# To process all 250 recipes, call with pagination:
#   &limit=50&offset=0  → &offset=50 → &offset=100 → …until remaining=0
